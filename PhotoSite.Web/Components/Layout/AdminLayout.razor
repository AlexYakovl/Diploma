@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject PhotoSite.Web.Components.Services.AuthStateService AuthState

<div class="admin-shell">
    <div class="admin-layout">
        <header class="admin-topbar" aria-label="Мобильное меню администратора">
            <button type="button"
                    class="admin-topbar__menu"
                    @onclick="ToggleNav"
                    aria-controls="admin-drawer"
                    aria-expanded="@_navOpen">
                <MudIcon Icon="@Icons.Material.Outlined.Menu" />
            </button>

            <div class="admin-topbar__titles">
                <div class="admin-topbar__kicker">Админ-панель</div>
            </div>
        </header>

        <aside class="admin-sidebar admin-dotgrid" aria-label="Навигация администратора">
            <div class="admin-brand">
                <div class="admin-brand-text">
                    <div class="admin-brand-subtitle">Админ-панель</div>
                </div>
            </div>

            <nav class="admin-nav">
                <NavLink href="/admin" Match="NavLinkMatch.All" class="admin-nav-link">
                    <span class="admin-nav-ic" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Outlined.Dashboard" />
                    </span>
                    Панель
                </NavLink>

                <NavLink href="/admin/albums" Match="NavLinkMatch.Prefix" class="admin-nav-link">
                    <span class="admin-nav-ic" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Outlined.PhotoAlbum" />
                    </span>
                    Альбомы
                </NavLink>

                <NavLink href="/admin/categories" Match="NavLinkMatch.Prefix" class="admin-nav-link">
                    <span class="admin-nav-ic" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Outlined.Category" />
                    </span>
                    Категории
                </NavLink>

                <NavLink href="/admin/reviews" Match="NavLinkMatch.Prefix" class="admin-nav-link">
                    <span class="admin-nav-ic" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Outlined.RateReview" />
                    </span>
                    Отзывы
                </NavLink>
            </nav>

            <div class="admin-sidebar-footer">
                <a class="admin-outlink" href="/" title="Открыть основной сайт">
                    <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" />
                    Основной сайт
                </a>

                <button type="button" class="admin-logout" @onclick="Logout">
                    <MudIcon Icon="@Icons.Material.Outlined.Logout" />
                    Выйти
                </button>
            </div>
        </aside>

        <aside id="admin-drawer"
               class="admin-drawer admin-dotgrid @( _navOpen ? "is-open" : null )"
               aria-hidden="@(!_navOpen)">
            <div class="admin-drawer-header">
                <div>
                    <div class="admin-brand-subtitle">Админ-панель</div>
                </div>
                <button type="button" class="admin-drawer-close" @onclick="CloseNav" aria-label="Закрыть меню">
                    <MudIcon Icon="@Icons.Material.Outlined.Close" />
                </button>
            </div>

            <nav class="admin-nav" @onclick="CloseNav">
                <NavLink href="/admin" Match="NavLinkMatch.All" class="admin-nav-link">
                    <span class="admin-nav-ic" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Outlined.Dashboard" />
                    </span>
                    Панель
                </NavLink>

                <NavLink href="/admin/albums" Match="NavLinkMatch.Prefix" class="admin-nav-link">
                    <span class="admin-nav-ic" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Outlined.PhotoAlbum" />
                    </span>
                    Альбомы
                </NavLink>

                <NavLink href="/admin/categories" Match="NavLinkMatch.Prefix" class="admin-nav-link">
                    <span class="admin-nav-ic" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Outlined.Category" />
                    </span>
                    Категории
                </NavLink>

                <NavLink href="/admin/reviews" Match="NavLinkMatch.Prefix" class="admin-nav-link">
                    <span class="admin-nav-ic" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Outlined.RateReview" />
                    </span>
                    Отзывы
                </NavLink>
            </nav>

            <div class="admin-sidebar-footer">
                <a class="admin-outlink" href="/" title="Открыть основной сайт" @onclick="CloseNav">
                    <MudIcon Icon="@Icons.Material.Outlined.OpenInNew" />
                    Основной сайт
                </a>

                <button type="button" class="admin-logout" @onclick="LogoutAndClose">
                    <MudIcon Icon="@Icons.Material.Outlined.Logout" />
                    Выйти
                </button>
            </div>
        </aside>

        @if (_navOpen)
        {
            <button type="button" class="admin-drawer-scrim" @onclick="CloseNav" aria-label="Закрыть меню"></button>
        }

        <main class="admin-content">
            <div class="admin-page">
                @Body
            </div>
        </main>
    </div>
</div>

@code {
    private bool _navOpen;

    private void ToggleNav() => _navOpen = !_navOpen;

    private void CloseNav() => _navOpen = false;

    private async Task LogoutAndClose()
    {
        CloseNav();
        await Logout();
    }

    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "jwt");
        AuthState.Invalidate();
        Nav.NavigateTo("/", forceLoad: true);
    }
}