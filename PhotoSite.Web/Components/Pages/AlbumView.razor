@page "/portfolio/{Id:int}"
@page "/portfolio/category/{CategoryId:int}/{Id:int}"
@using PhotoSite.Web.Components.UI
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>@(_album?.Title ?? "Альбом") — Мария Яковлева</PageTitle>

@if (_loading)
{
    <div style="text-align:center; padding:80px 0;">
        <MudProgressCircular Indeterminate="true" Color="Color.Dark" Size="Size.Large" />
    </div>
}
else if (_album == null)
{
    <div class="page-header">
        <p style="color:#aaa;">Альбом не найден.</p>
        <MudButton Href="/portfolio" Variant="Variant.Text" Style="margin-top:12px;">← Портфолио</MudButton>
    </div>
}
else
{
    <div class="page-header">
        <MudBreadcrumbs Items="_crumbs" Separator="/"
                        Style="justify-content:center; font-size:0.78rem; opacity:0.55; padding:0;" />
        <h1 class="page-header__title" style="margin-top:10px;">@_album.Title</h1>
        @if (!string.IsNullOrEmpty(_album.Description))
        {
            <p class="page-header__subtitle page-header__album-desc">@_album.Description</p>
        }
        <p style="font-size:0.78rem; color:#aaa; margin:6px 0 0;">
            @_photos.Count фото
        </p>
    </div>

    <div class="container" style="padding-bottom:80px;">
        <PhotoGrid Photos="_photos" AlbumId="Id" Refresh="LoadPhotos" />
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int? CategoryId { get; set; }

    private AlbumDto? _album;
    private List<PhotoDto> _photos = new();
    private bool _loading = true;
    private List<BreadcrumbItem> _crumbs = new();

    protected override async Task OnInitializedAsync()
    {
        _album = await Api.GetAlbumAsync(Id);
        if (_album != null)
        {
            var categoryId = CategoryId ?? _album.CategoryId;
            var categories = await Api.GetCategoriesAsync();
            var category = categories.FirstOrDefault(c => c.Id == categoryId);
            var categoryTitle = category?.Title ?? "Категория";

            _crumbs = new()
            {
                new BreadcrumbItem("Портфолио", href: "/portfolio"),
                new BreadcrumbItem(categoryTitle, href: $"/portfolio/category/{categoryId}"),
                new BreadcrumbItem(_album.Title, href: null, disabled: true)
            };
        }
        await LoadPhotos();
        _loading = false;
    }

    private async Task LoadPhotos()
    {
        _photos = await Api.GetAlbumPhotosAsync(Id);
        StateHasChanged();
    }
}
