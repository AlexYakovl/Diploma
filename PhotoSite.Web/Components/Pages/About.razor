@page "/about"

<PageTitle>О себе — Мария Яковлева</PageTitle>

<div class="page-header page-header--about">

    @if (_photos.Count > 0)
    {
        <div class="about-page-slider about-page-slider--full" @key="_sliderKey">
            <div class="uk-position-relative uk-visible-toggle" tabindex="-1" uk-slider="autoplay: true; autoplay-interval: 3000; pause-on-hover: true">
                <div class="uk-slider-items uk-child-width-1-2 uk-child-width-1-3@s uk-child-width-1-4@m uk-child-width-1-5@l uk-child-width-1-6@xl uk-grid">
                    @foreach (var p in _photos)
                    {
                        <div>
                            <div class="uk-panel about-slider-panel">
                                <img src="@FullPhotoUrl(p)" width="400" height="600" loading="eager" alt="Работы" />
                            </div>
                        </div>
                    }
                </div>

                <a class="uk-position-center-left uk-position-small uk-hidden-hover" href="" uk-slidenav-previous uk-slider-item="previous"></a>
                <a class="uk-position-center-right uk-position-small uk-hidden-hover" href="" uk-slidenav-next uk-slider-item="next"></a>
            </div>
        </div>
    }
    else if (_isAdmin)
    {
        <p class="page-header__slider-empty">Слайдер пуст. Загрузите фотографии ниже.</p>
    }

    <div class="page-header__intro">
        <span class="section-label"></span>
    </div>

    @if (_isAdmin)
    {
        <div class="page-header__intro about-slider-admin">
            <div class="about-slider-upload" style="margin-top:4px;">
                <input type="file"
                       id="aboutSliderUpload"
                       @ref="_aboutSliderInputRef"
                       accept=".jpg,.jpeg,.png,.webp"
                       style="display:none"
                       multiple
                       disabled="@AboutSliderBusy"
                       @onchange="AboutSliderNativeChanged" />
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           Class="about-slider-upload-btn"
                           Disabled="@AboutSliderBusy"
                           StartIcon="@Icons.Material.Outlined.AddPhotoAlternate"
                           Style="border-style:dashed; font-size:0.85rem;"
                           OnClick="PickAboutSliderFilesAsync">
                    @(_aboutSliderUploading ? "Загрузка…" : _aboutDeletingPhotoId.HasValue ? "Удаление…" : "Добавить в слайдер")
                </MudButton>
                @if (_aboutSliderUploading)
                {
                    <div class="photosite-upload-progress" style="max-width:420px; margin-left:auto; margin-right:auto; margin-top:12px;">
                        <div class="photosite-upload-progress__label">@_aboutSliderUploadLabel</div>
                        <div class="photosite-upload-progress__track">
                            <div class="photosite-upload-progress__fill" style="width:@($"{_aboutSliderUploadPct:0}%")"></div>
                        </div>
                        <div class="photosite-upload-progress__pct">@_aboutSliderUploadPct.ToString("0")%</div>
                    </div>
                }
            </div>
            @if (_photos.Count > 0)
            {
                <div class="about-slider-admin-chips" style="margin-top:12px; display:flex; flex-wrap:wrap; gap:6px; justify-content:center; align-items:center;">
                    @foreach (var p in _photos)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                   Class="about-slider-delete-chip"
                                   Ripple="false"
                                   Style="min-height:32px; padding:4px 10px; font-size:0.75rem; text-transform:none; line-height:1;"
                                   Disabled="@AboutSliderBusy"
                                   OnClick="() => DeleteAboutPhoto(p)" title="Удалить слайд">
                            <span class="about-slider-delete-chip-inner">
                                <span class="about-slider-delete-chip-id">#@p.Id</span>
                                <span class="about-slider-delete-chip-trail">
                                    @if (_aboutDeletingPhotoId == p.Id)
                                    {
                                        <span class="about-slider-delete-chip-spinner" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Close"
                                                 Class="about-slider-delete-chip-icon"
                                                 Style="margin:0;" />
                                    }
                                </span>
                            </span>
                        </MudButton>
                    }
                </div>
            }
        </div>
    }
</div>

<div class="container" style="padding-bottom:80px; max-width:980px;">

    @* Одна сетка: порядок — про стиль → где снимаю → как проходит → что получите.
       На md+ «Где я снимаю» и «Как проходит съёмка» в одном ряду (оба md=6). *@
    <MudGrid Spacing="3" Class="photosite-grid-singlecol-md" Style="margin-bottom:40px;">
        <MudItem xs="12">
            <div style="border:1px solid #e0e0e0; border-radius:6px; padding:26px 22px; background:#0a0a0a; height:100%;">
                <h2 class="display-title" style="font-size:1.5rem; margin:10px 0 12px; color:#fff;">Про стиль и обработку</h2>
                <p style="color:#ccc; line-height:1.8; margin:0; font-size:0.95rem;">
                    Я люблю минимализм, лаконичный стиль и стремлюсь к этому в своих фотографиях.
                    При обработке я не меняю людей до неузнаваемости с помощью ретуши и пластики.
                </p>
            </div>
        </MudItem>
        <MudItem xs="12" md="6">
            <div style="border:1px solid #e0e0e0; border-radius:6px; padding:26px 22px; background:#fff; height:100%;">
                <h2 class="display-title" style="font-size:1.5rem; margin:10px 0 12px;">Где я снимаю</h2>
                <p style="color:#555; line-height:1.85; font-size:0.95rem; margin:8px 0 14px;">
                    Это может быть уличная локация, фотостудия или ваша квартира — всё зависит от формата и концепции съёмки,
                    количества людей. Я всегда порекомендую место, которое наилучшим образом подойдёт для вашей съёмки.
                </p>
                <p style="color:#555; line-height:1.85; font-size:0.95rem; margin:0 0 10px;">
                    Фотостудия бронируется мной или вами (по желанию), обычно заранее, за отдельную стоимость,
                    которая не входит в стоимость моей работы.
                </p>
            </div>
        </MudItem>
        <MudItem xs="12" md="6">
            <div style="border:1px solid #e0e0e0; border-radius:6px; padding:26px 22px; background:#fff; height:100%;">
                <h2 class="display-title" style="font-size:1.5rem; margin:10px 0 12px;">Как проходит съёмка</h2>
                <p style="color:#555; line-height:1.85; font-size:0.95rem; margin:8px 0 14px;">
                    Процесс начинается задолго до того, как мы с вами встретимся. Сначала мы обсуждаем концепцию съёмки,
                    место и одежду. Чем больше людей, тем больше подготовительной работы нужно будет провести.
                </p>
                <p style="color:#555; line-height:1.85; font-size:0.95rem; margin:0;">
                    От меня вы можете получить рекомендации по образам, цветовым сочетаниям в одежде, месту съёмки.
                    Поэтому фотосессия бронируется по предоплате (1500 р.). В процессе съёмки я помогу вам с позированием —
                    мы вместе постараемся прийти к результату, который вас устроит.
                </p>
            </div>
        </MudItem>
        <MudItem xs="12">
            <div style="border:1px solid #e0e0e0; border-radius:6px; padding:26px 22px; background:#fff; height:100%; text-align:center;">
                <h2 class="display-title" style="font-size:1.5rem; margin:10px 0 16px;">Что вы получите</h2>
                <div style="display:flex; flex-direction:column; gap:2px;">
                    @foreach (var item in _youGet)
                    {
                        @* Галочка и текст — одна компактная группа, целиком по центру карточки *@
                        <div style="text-align:center; padding:6px 0;">
                            <span style="display:inline-flex; align-items:flex-start; gap:7px; max-width:min(540px,100%); vertical-align:top;">
                                <MudIcon Icon="@Icons.Material.Filled.Check"
                                         Style="font-size:1rem; color:#999; margin-top:2px; flex-shrink:0;" />
                                <span style="font-size:0.95rem; color:#555; line-height:1.65; text-align:center; min-width:0; max-width:min(29rem, calc(100vw - 5rem));">@item</span>
                            </span>
                        </div>
                    }
                </div>
            </div>
        </MudItem>
    </MudGrid>

    <section class="section section--gray" style="margin-top:56px; padding-top:52px; padding-bottom:52px; border-radius:6px;">
        <div class="container" style="max-width:900px;">
            <div style="text-align:center; margin-bottom:34px;">
                <h2 class="display-title" style="font-size:1.5rem; margin-top:10px;">
                    Частые вопросы
                </h2>
            </div>
            <MudExpansionPanels Elevation="0">
                @foreach (var f in _faqs)
                {
                    <MudExpansionPanel Text="@f.Q"
                                       Style="border-bottom:1px solid #ddd; border-radius:0 !important; background:transparent;">
                        <p style="color:#555; line-height:1.8; font-size:0.95rem; margin:4px 0 16px;">@f.A</p>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </div>
    </section>

    <div style="margin-top:56px; text-align:center;">
        <h3 class="display-title" style="font-size:1.7rem; margin:0 0 10px;">Готовы к съёмке?</h3>
        <p style="color:#666; font-size:0.95rem; margin:0 0 22px;">
            Посмотрите примеры работ или сразу перейдите к стоимости и условиям.
        </p>
        <div class="about-cta">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                       Href="/portfolio"
                       Style="border-width:1.5px; letter-spacing:0.06em; padding:12px 30px;">
                Портфолио
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       Href="/services"
                       Style="letter-spacing:0.06em; padding:12px 30px;">
                Услуги и стоимость
            </MudButton>
        </div>
    </div>
</div>
