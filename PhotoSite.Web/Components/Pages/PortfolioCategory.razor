@page "/portfolio/category/{Id:int}"
@using PhotoSite.Web.Components.UI
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>@(_category?.Title ?? "Категория") — Мария Яковлева</PageTitle>

@if (_loading)
{
    <div style="text-align:center; padding:80px 0;">
        <MudProgressCircular Indeterminate="true" Color="Color.Dark" Size="Size.Large" />
    </div>
}
else if (_category == null)
{
    <div class="page-header">
        <p style="color:#aaa;">Категория не найдена.</p>
        <MudButton Href="/portfolio" Variant="Variant.Text" Style="margin-top:12px;">← Портфолио</MudButton>
    </div>
}
else
{
    <div class="page-header">
        <MudBreadcrumbs Items="_crumbs" Separator="/"
                        Style="justify-content:center; font-size:0.78rem; opacity:0.55; padding:0;" />
        <h1 class="page-header__title" style="margin-top:10px;">@_category.Title</h1>
        <p style="font-size:0.78rem; color:#aaa; margin:6px 0 0;">
            @_albums.Count @($"альбом{GetAlbumsWordEnding(_albums.Count)}")
        </p>
    </div>

    <div class="container" style="padding-bottom:80px;">
        @if (_albums.Count == 0)
        {
            <div style="text-align:center; padding:60px 0;">
                <MudIcon Icon="@Icons.Material.Outlined.PhotoLibrary"
                         Style="font-size:3.5rem; color:#ccc; display:block; margin:0 auto 12px;" />
                <p style="color:#aaa; margin:0;">Пока нет альбомов.</p>
            </div>
        }
        else
        {
            <MudGrid Spacing="3">
                @foreach (var album in _albums)
                {
                    <MudItem xs="12" sm="6">
                        <AlbumCard AlbumId="album.Id"
                                   Title="@album.Title"
                                   Description="@album.Description"
                                   CoverPath="@album.CoverPath"
                                   OnClick="@(() => GoToAlbum(album.Id))" />
                    </MudItem>
                }
            </MudGrid>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private CategoryListItemDto? _category;
    private List<AlbumDto> _albums = new();
    private bool _loading = true;
    private List<BreadcrumbItem> _crumbs = new();

    protected override async Task OnInitializedAsync()
    {
        var categories = await Api.GetCategoriesAsync();
        _category = categories.FirstOrDefault(c => c.Id == Id);
        if (_category != null)
        {
            _crumbs = new()
            {
                new BreadcrumbItem("Портфолио", href: "/portfolio"),
                new BreadcrumbItem(_category.Title, href: null, disabled: true)
            };
            _albums = await Api.GetAlbumsByCategoryAsync(Id);
        }

        _loading = false;
    }

    private void GoToAlbum(int id) => Nav.NavigateTo($"/portfolio/category/{Id}/{id}");

    private static string GetAlbumsWordEnding(int count)
    {
        var n = Math.Abs(count) % 100;
        var n1 = n % 10;
        if (n is >= 11 and <= 19) return "ов";
        if (n1 == 1) return "";
        if (n1 is >= 2 and <= 4) return "а";
        return "ов";
    }
}

