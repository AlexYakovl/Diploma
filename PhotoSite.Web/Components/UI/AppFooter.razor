<footer class="app-footer">
    <div class="container">
        <MudGrid Spacing="4" Class="footer-grid">
            <MudItem xs="12" sm="6" md="4" Class="footer-col">
                <p class="footer-name">Мария Яковлева</p>
                <p class="footer-tag">Фотограф · Сургут, Россия</p>
            </MudItem>
            <MudItem xs="12" sm="6" md="4" Class="footer-col footer-col--contacts">
                <p class="footer-block-title">Связь</p>
                <ContactLinks IsFooter="true" />
            </MudItem>
            <MudItem xs="12" md="4" Class="footer-col footer-col--meta">
                <p class="footer-copy">&copy; @DateTime.Now.Year Мария Яковлева</p>
            </MudItem>
        </MudGrid>
        <MudDivider Style="border-color:#2a2a2a; margin:28px 0 18px;" />
        <p class="footer-quote">Фотография — это искусство замороженного времени.</p>
    </div>
</footer>
